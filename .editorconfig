# 机器能查的编程规范。说明见 Docs/编程规范.md。
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,asmdef,json}]
indent_style = space
indent_size = 4

[*.cs]
# 大括号各占一行；只有一句也加大括号
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:warning

# 访问修饰符全部写明
dotnet_style_require_accessibility_modifiers = always:warning

# 命名空间用大括号包起来（C# 9 没有文件级命名空间）
csharp_style_namespace_declarations = block_scoped:warning

# 只有一个表达式的属性和方法用 =>
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

# 右边一眼看得出类型时才用 var
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# using 放在命名空间外面，System 开头的排前面
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# ---- 命名 ----

# 接口：I 开头
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case

# 常量、static readonly：首字母大写的驼峰（要排在私有字段那条规则前面）
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_are_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_are_pascal.style = pascal
dotnet_naming_rule.static_readonly_are_pascal.severity = warning
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly

# 私有字段：下划线加首字母小写的驼峰
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# 类型、方法、属性、事件：首字母大写的驼峰
dotnet_naming_rule.members_are_pascal.symbols = types_and_members
dotnet_naming_rule.members_are_pascal.style = pascal
dotnet_naming_rule.members_are_pascal.severity = warning
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

# 参数、局部变量：首字母小写的驼峰
dotnet_naming_rule.locals_are_camel.symbols = locals
dotnet_naming_rule.locals_are_camel.style = camel
dotnet_naming_rule.locals_are_camel.severity = warning
dotnet_naming_symbols.locals.applicable_kinds = parameter, local
dotnet_naming_style.camel.capitalization = camel_case

# 测试方法是一句中文，不受上面的命名规则管
[Assets/Tests/**.cs]
dotnet_naming_rule.members_are_pascal.severity = none
